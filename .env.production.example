# VPS Jejakode: isi email pengelola sertifikat & kredensial Google OAuth di .env.production.
COUP_DOMAIN=coup.jejakode.com
COUP_ORIGIN=https://coup.jejakode.com
ACME_EMAIL=
PROXY_NETWORK=shared-network

# Database (default: SQLite bawaan Node 22 di /app/data/coup.db; siap migrasi lewat repository layer)
DATABASE_DRIVER=sqlite
DATABASE_PATH=/app/data/coup.db

# Google OAuth 2.0 (wajib untuk semua pemain)
# Redirect URI di Google Cloud Console:
# - Production: https://coup.jejakode.com/api/auth/google/callback
# - Localhost:  http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate secret acak 32+ byte (misal: openssl rand -hex 32) atau di windows: powershell -Command "[System.Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) )"
AUTH_SESSION_SECRET=
